# .env.example
# -------------
# Copy this file to .env and fill in the values.
# The .env file is git-ignored — never commit real secrets.
#
# Usage (PowerShell):
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^([^#][^=]*)=(.*)$') {
#       [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
#     }
#   }
#   python server_http.py

# ── Authentication ────────────────────────────────────────────────────────────
# Shared Bearer token for all teammates.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (local testing only — NOT safe over ngrok).
MCP_API_KEY=feedstock-secret-changeme

# ── Server bind ───────────────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ── Allowed hosts (comma-separated, * = allow all) ───────────────────────────
MCP_ALLOWED_HOSTS=*

# ── Data & logging ───────────────────────────────────────────────────────────
DATA_BACKEND=csv
LOG_LEVEL=INFO
